<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orange_primary"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIS"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STUDENT INFORMATION SYSTEM"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDENT REGISTRATION"
                android:textSize="12sp"
                android:textColor="@color/orange_light"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
        <!-- STUDENT NUMBER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDENT NUMBER"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/orange_dark"/>
            <EditText
                android:id="@+id/edtStudentNumber"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Student Number"
                android:singleLine="true"
                android:inputType="text"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="15dp"/>
        </LinearLayout>
        <!-- STUDENT NAME CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDENT NAME"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/orange_dark"/>
            <EditText
                android:id="@+id/edtLastName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Last Name"
                android:singleLine="true"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="15dp"/>
            <EditText
                android:id="@+id/edtFirstName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="First Name"
                android:singleLine="true"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="12dp"/>
            <EditText
                android:id="@+id/edtMiddleName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Middle Name"
                android:singleLine="true"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
        <!-- STUDENT ACADEMIC INFORMATION CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDENT ACADEMIC INFORMATION"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/orange_dark"/>
            <!-- PROGRAM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROGRAM"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="18dp"/>
            <Spinner
                android:id="@+id/spinnerProgram"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginTop="7dp"/>
            <!-- YEAR LEVEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YEAR LEVEL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="18dp"/>
            <Spinner
                android:id="@+id/spinnerYear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginTop="7dp"/>
        </LinearLayout>
        <!-- BUTTONS -->
        <Button
            android:id="@+id/btnSaveStudent"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="SAVE STUDENT"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"/>
        <Button
            android:id="@+id/btnClearForm"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="CLEAR FORM"
            android:textColor="@color/orange_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginTop="10dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT INFORMATION SYSTEM"
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"/>
    </LinearLayout>
</ScrollView>